# 复制成 .env 再填。.env 已在 .gitignore 里。
# 规矩：prompt 里只提变量名，不提值 —— prompt 会被截图。

# ---------------------------------------------------------------------------
# 火山引擎 豆包语音（TTS）
# 新版控制台 > API Key 管理。volcano-stream 和 volcano-audio 都用这一个。
# ---------------------------------------------------------------------------
VOLC_TTS_API_KEY=

# 旧版控制台的双头鉴权，仅 volcano-audio 支持。有 API Key 就不用填这两个。
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_KEY=

# ---------------------------------------------------------------------------
# 可选：其他服务
# ---------------------------------------------------------------------------
# ELEVENLABS_API_KEY=
# FAL_KEY=
# OPENROUTER_API_KEY=
