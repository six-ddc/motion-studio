{
  "schema": 1,
  "gates": [
    {
      "id": "shotlist",
      "about": "check_shotlist.py：分镜 ↔ narration.json 对账（锚点、覆盖、重要区间时长、旁白断言）+ 发散留痕。只声明 divergence 时只查留痕",
      "when": { "checks": ["shotlist", "divergence"] },
      "run": ["python", "{skill}/scripts/check_shotlist.py", "--film", "{slug}", "--films-dir", "{films}"],
      "cost": 1
    },
    {
      "id": "factcheck",
      "about": "factcheck.mjs：旁白稿里的每个数字在 docs/facts.md 有账（值 + 单位 + 事实状态）",
      "when": { "checks": ["facts.script"] },
      "run": ["node", "{skill}/scripts/factcheck.mjs", "--film", "{slug}", "--films-dir", "{films}"],
      "cost": 1
    }
  ]
}
