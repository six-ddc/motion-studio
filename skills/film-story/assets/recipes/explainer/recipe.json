{
  "schema": 1,
  "name": "explainer",
  "tags": ["解说片", "科普", "旁白先行", "调研", "分镜", "explainer"],
  "about": "解说片配方：brief → 调研 → 机制 → 旁白（音频先行）→ 分镜 → 实现 → 静帧 → 渲染 → 自检 → 合流 → 交付。写全套文档模板，并在 film.json checks 声明这套流程用到的检查。",
  "files": [
    { "dest": "docs/brief.md", "from": "brief.md" },
    { "dest": "docs/PROGRESS.md", "from": "PROGRESS.md" },
    { "dest": "docs/facts.md", "skill": "film-story", "from": "assets/facts.template.md" },
    { "dest": "docs/mechanism.md", "skill": "film-story", "from": "assets/mechanism.md" },
    { "dest": "docs/shotlist.md", "skill": "film-story", "from": "assets/shotlist.md" },
    { "dest": "docs/style_guide.md", "skill": "film-story", "from": "assets/style_guide.md" },
    { "dest": "docs/review_log.md", "skill": "film-critique", "from": "assets/review_log.md" },
    { "dest": "script.json", "skill": "film-narration", "from": "assets/script.template.json",
      "fallback": { "engine": "volcano-stream", "speaker": "去 film-narration 跑音色筛选再填，不要硬编码", "format": "mp3", "sampleRate": 44100,
                    "speechRate": 0, "gap": 0.6, "pronunciationDict": { "tone": [] }, "lines": [{ "id": "s1", "text": "" }] } }
  ],
  "film": { "narrationOffset": 0, "narrationTail": 0 },
  "checks": ["shotlist", "divergence", "facts.script", "facts.screen", "verify",
             "narration", "mp4", "truepeak", "loop", "readability", "contrast", "style-guide",
             "laws", "still", "empty", "marks", "claims", "tilt", "page"],
  "next": [
    "1. 填 docs/brief.md —— 时长和画幅先定，改动成本最高",
    "2. 调研 → docs/facts.md",
    "3. 机制 → docs/mechanism.md + docs/style_guide.md（机制 → 讲法 → 视觉方向，三次发散都留痕）",
    "4. 旁白 → narration.json（音频先行，时长从这来）",
    "5. 分镜 → docs/shotlist.md",
    "6. 写 scene.html（守 film-core references/kernel.md）",
    "7. 静帧闸门，别直接渲整片",
    "中途停下时在 docs/PROGRESS.md 记当前问题和下一步（几行，过时就删）"
  ]
}
